<!DOCTYPE html>
<html class="dark" lang="es">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0, maximum-scale=5.0" name="viewport"/>
    <meta content="mobile_tab" name="shell-type"/>
    <title id="app-title-head">Aura Sovereign App</title>
    <link href="https://fonts.googleapis.com" rel="preconnect"/>
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&family=Fira+Code:wght@400;600&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "surface": "#10131a",
              "surface-container": "#1d1f27",
              "surface-container-high": "#272a32",
              "surface-container-lowest": "#0b0e15",
              "primary": "var(--color-primary, #00f0ff)",
              "secondary": "var(--color-secondary, #d0bcff)",
              "tertiary": "var(--color-tertiary, #6ffbbe)",
              "on-surface": "#e1e2ec",
              "on-surface-variant": "#b9cacb"
            }
          }
        }
      };
    </script>
    <style>
      :root {
        --color-primary: #00f0ff;
        --color-secondary: #d0bcff;
        --color-tertiary: #6ffbbe;
      }
      .theme-cyan { --color-primary: #00f0ff; --color-secondary: #d0bcff; --color-tertiary: #6ffbbe; }
      .theme-emerald { --color-primary: #10b981; --color-secondary: #6EE7B7; --color-tertiary: #a7f3d0; }
      .theme-violet { --color-primary: #a855f7; --color-secondary: #f472b6; --color-tertiary: #c084fc; }
      .theme-mono { --color-primary: #ffffff; --color-secondary: #9ca3af; --color-tertiary: #d1d5db; }

      @layer base {
        html, body { width: 100%; margin: 0; padding: 0; overscroll-behavior: none; }
        .pb-safe { padding-bottom: env(safe-area-inset-bottom, 0px); }
        .pt-safe { padding-top: env(safe-area-inset-top, 0px); }
      }
      ::-webkit-scrollbar { display: none; }
      
      .font-inter { font-family: 'Inter', sans-serif; }
      .font-jakarta { font-family: 'Plus Jakarta Sans', sans-serif; }
      .font-mono-custom { font-family: 'Fira Code', monospace; }
      
      .style-bento { border-radius: 0.75rem; border: 1px solid rgba(255,255,255,0.08); }
      .style-neon { border-radius: 0.5rem; border: 1px solid var(--color-primary); box-shadow: 0 0 10px rgba(0,240,255,0.15); }
      .style-minimal { border-radius: 0.25rem; border: none; }

      /* Optimización de Renderizado mediante Hardware GPU */
      .hardware-accelerated {
        will-change: transform, opacity;
        transform: translateZ(0);
      }

      .nav-style-glow .nav-btn.active { box-shadow: 0 0 12px var(--color-primary); }
      .nav-style-chips .nav-btn { border-radius: 9999px; }
      .nav-style-line .nav-btn.active { border-bottom: 2px solid var(--color-primary); border-radius: 0; background: transparent !important; color: var(--color-primary) !important; }
    </style>
    <link rel="manifest" href="manifest.json"/>
    <meta name="theme-color" content="#000000"/>
</head>
<body id="app-body" class="bg-surface font-jakarta text-on-surface antialiased flex flex-col min-h-screen selection:bg-primary selection:text-black theme-cyan">

    <!-- CABECERA ADAPTATIVA FIJA -->
    <header class="fixed top-0 inset-x-0 z-40 bg-surface-container-lowest/90 backdrop-blur-xl border-b border-white/5 pt-safe">
        <div class="h-14 px-4 max-w-7xl mx-auto flex items-center justify-between gap-2">
            <div class="flex items-center gap-2 min-w-0">
                <div id="app-logo-box" class="w-9 h-9 rounded-lg bg-primary/10 border border-primary/30 flex items-center justify-center flex-shrink-0">
                    <span id="app-logo-icon" class="material-symbols-outlined text-primary text-[22px]">hub</span>
                </div>
                <div class="flex flex-col min-w-0">
                    <span id="app-name-display" class="font-bold text-sm tracking-tight text-on-surface truncate">OBSIDIAN NEXUS</span>
                    <span class="text-[9px] text-tertiary tracking-widest uppercase font-mono">CROSS-PLATFORM OS // OPTIMIZED</span>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <span id="cpu-ram-badge" class="hidden sm:inline-flex text-[10px] font-mono bg-surface-container-high border border-white/10 px-2 py-1 rounded text-tertiary">CPU: OK | RAM: Low</span>
                <button onclick="toggleSettingsModal()" class="w-10 h-10 rounded-full bg-surface-container-high hover:bg-primary/20 text-primary border border-primary/30 flex items-center justify-center shadow-lg transition-all active:scale-95" aria-label="Ajustes">
                    <span class="material-symbols-outlined text-[20px]">settings</span>
                </button>
            </div>
        </div>

        <nav id="nav-container" class="nav-style-glow flex items-center gap-1 px-4 pb-2 max-w-7xl mx-auto overflow-x-auto text-xs font-semibold no-scrollbar">
            <button onclick="switchTab('tab-assistant')" id="nav-tab-assistant" class="nav-btn active px-3 py-1.5 rounded-lg bg-primary text-black flex items-center gap-1.5 flex-shrink-0 transition-all">
                <span class="material-symbols-outlined text-[16px]">smart_toy</span><span>Asistente</span>
            </button>
            <button onclick="switchTab('tab-files')" id="nav-tab-files" class="nav-btn px-3 py-1.5 rounded-lg bg-surface-container-high text-on-surface-variant flex items-center gap-1.5 flex-shrink-0 hover:text-on-surface transition-all">
                <span class="material-symbols-outlined text-[16px]">folder_open</span><span>Archivos & Reparación</span>
            </button>
            <button onclick="switchTab('tab-updates')" id="nav-tab-updates" class="nav-btn px-3 py-1.5 rounded-lg bg-surface-container-high text-on-surface-variant flex items-center gap-1.5 flex-shrink-0 hover:text-on-surface transition-all">
                <span class="material-symbols-outlined text-[16px]">system_update</span><span>Actualizaciones SO & App</span>
            </button>
            <button onclick="switchTab('tab-monitoring')" id="nav-tab-monitoring" class="nav-btn px-3 py-1.5 rounded-lg bg-surface-container-high text-on-surface-variant flex items-center gap-1.5 flex-shrink-0 hover:text-on-surface transition-all">
                <span class="material-symbols-outlined text-[16px]">monitor_heart</span><span>Monitor & Red</span>
            </button>
            <button onclick="switchTab('tab-security')" id="nav-tab-security" class="nav-btn px-3 py-1.5 rounded-lg bg-surface-container-high text-on-surface-variant flex items-center gap-1.5 flex-shrink-0 hover:text-on-surface transition-all">
                <span class="material-symbols-outlined text-[16px]">security</span><span>Seguridad</span>
            </button>
        </nav>
    </header>

    <!-- CONTENEDOR DE PÁGINAS -->
    <main class="flex-1 pt-28 pb-10 px-4 max-w-5xl mx-auto w-full hardware-accelerated">

        <!-- 1. ASISTENTE -->
        <section id="tab-assistant" class="tab-content flex flex-col gap-4">
            <div class="p-4 rounded-xl bg-surface-container border border-white/5 flex flex-col gap-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-mono text-tertiary flex items-center gap-1">
                        <span class="w-2 h-2 rounded-full bg-tertiary animate-pulse"></span> MOTOR NEURONAL OPTIMIZADO
                    </span>
                    <button onclick="clearChat()" class="text-[10px] text-on-surface-variant hover:text-primary font-mono underline">Limpiar Memoria Chat</button>
                </div>
                <div id="chat-box" class="h-64 sm:h-80 rounded-lg bg-surface-container-lowest p-3 overflow-y-auto text-xs font-mono flex flex-col gap-2 border border-white/5">
                    <div class="bg-surface-container-high p-2.5 rounded-lg max-w-[85%] self-start text-on-surface">
                        Entorno multithread optimizado. Inicia tus comandos de diagnóstico o edición.
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <input type="text" id="chat-input" placeholder="Escribe tu comando..." class="flex-1 bg-surface-container-lowest border border-white/10 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-primary">
                    <button onclick="sendChatMessage()" class="w-9 h-9 rounded-lg bg-primary text-black flex items-center justify-center font-bold">
                        <span class="material-symbols-outlined text-[18px]">send</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- 2. ARCHIVOS & REPARACIÓN -->
        <section id="tab-files" class="tab-content hidden flex flex-col gap-4">
            <div class="p-4 rounded-xl bg-surface-container border border-white/5 flex flex-col gap-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-primary flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[18px]">drive_file_move</span> Gestor de Archivos & Reparación
                    </span>
                    <span class="text-[10px] font-mono bg-primary/10 text-primary px-2 py-0.5 rounded">ACCESO DIRECTO</span>
                </div>
                <div class="flex items-center gap-2">
                    <input type="file" id="file-input-local" onchange="loadLocalFile(event)" class="hidden">
                    <button onclick="document.getElementById('file-input-local').click()" class="flex-1 py-2 px-3 bg-primary/20 text-primary border border-primary/30 rounded-lg text-xs font-bold flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-[18px]">upload_file</span>
                        <span>Abrir Archivo de Almacenamiento Local</span>
                    </button>
                </div>
                <div id="file-editor-container" class="hidden flex flex-col gap-2 mt-2">
                    <div class="flex items-center justify-between">
                        <span id="file-name-label" class="text-xs font-mono text-tertiary">archivo.txt</span>
                        <span id="file-size-label" class="text-[10px] text-on-surface-variant font-mono">0 KB</span>
                    </div>
                    <textarea id="file-content-area" rows="8" class="w-full bg-surface-container-lowest border border-white/10 rounded-lg p-2.5 text-xs font-mono text-on-surface focus:outline-none focus:border-primary"></textarea>
                    <button onclick="saveModifiedFile()" class="py-2 bg-tertiary text-black font-bold text-xs rounded-lg flex items-center justify-center gap-1">
                        <span class="material-symbols-outlined text-[16px]">save</span> Guardar Versión Reparada
                    </button>
                </div>
            </div>
        </section>

        <!-- 3. ACTUALIZACIONES SO & APP -->
        <section id="tab-updates" class="tab-content hidden flex flex-col gap-4">
            <div class="p-4 rounded-xl bg-surface-container border border-white/5 flex flex-col gap-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-secondary flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[18px]">phone_android</span> Diagnóstico de Sistema Operativo
                    </span>
                    <button onclick="checkOsStatus()" class="text-[10px] bg-secondary/10 text-secondary px-2 py-0.5 rounded font-mono">Buscar</button>
                </div>
                <div class="bg-surface-container-lowest p-3 rounded-lg border border-white/5 flex flex-col gap-1.5 text-xs font-mono">
                    <div class="flex items-center justify-between">
                        <span class="text-on-surface-variant">Plataforma Detectada:</span>
                        <span id="os-platform-text" class="text-primary truncate max-w-[200px]">Detectando...</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-on-surface-variant">Rendimiento CPU / RAM:</span>
                        <span id="os-status-text" class="text-tertiary">Optimizado</span>
                    </div>
                </div>
            </div>

            <div class="p-4 rounded-xl bg-surface-container border border-white/5 flex flex-col gap-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-primary flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[18px]">update</span> Mantenimiento e Inyección de Parches
                    </span>
                    <span class="text-[10px] font-mono bg-primary/10 text-primary px-2 py-0.5 rounded">v5.2.0</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    <button onclick="updateServiceWorker()" class="p-3 bg-surface-container-lowest rounded-lg border border-white/5 flex items-center justify-between text-left">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-tertiary text-[20px]">published_with_changes</span>
                            <span class="font-bold text-xs">Refrescar Service Worker</span>
                        </div>
                    </button>
                    <button onclick="optimizeAppPerformance()" class="p-3 bg-surface-container-lowest rounded-lg border border-white/5 flex items-center justify-between text-left">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary text-[20px]">memory</span>
                            <span class="font-bold text-xs">Liberar Memoria RAM</span>
                        </div>
                    </button>
                </div>
            </div>
        </section>

        <!-- 4. MONITORIZACIÓN & RED -->
        <section id="tab-monitoring" class="tab-content hidden flex flex-col gap-4">
            <div class="p-4 rounded-xl bg-surface-container border border-white/5 flex flex-col gap-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-primary flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[18px]">speed</span> Telemetría de Dispositivo
                    </span>
                    <button onclick="initDeviceMonitoring()" class="text-[10px] bg-primary/10 text-primary px-2 py-0.5 rounded font-mono">Actualizar</button>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                    <div class="bg-surface-container-lowest p-3 rounded-lg border border-white/5 flex flex-col">
                        <span class="text-[10px] text-on-surface-variant font-mono">BATERÍA</span>
                        <span id="metric-battery" class="text-sm font-bold text-tertiary mt-1">100%</span>
                    </div>
                    <div class="bg-surface-container-lowest p-3 rounded-lg border border-white/5 flex flex-col">
                        <span class="text-[10px] text-on-surface-variant font-mono">NÚCLEOS CPU</span>
                        <span id="metric-cores" class="text-sm font-bold text-primary mt-1">Multi-Core</span>
                    </div>
                    <div class="bg-surface-container-lowest p-3 rounded-lg border border-white/5 flex flex-col">
                        <span class="text-[10px] text-on-surface-variant font-mono">USO MEMORIA</span>
                        <span id="metric-ram" class="text-sm font-bold text-secondary mt-1">Bajo</span>
                    </div>
                    <div class="bg-surface-container-lowest p-3 rounded-lg border border-white/5 flex flex-col">
                        <span class="text-[10px] text-on-surface-variant font-mono">CONEXIÓN</span>
                        <span id="metric-network" class="text-sm font-bold text-on-surface mt-1">Air-Gap</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- 5. SEGURIDAD & DATOS -->
        <section id="tab-security" class="tab-content hidden flex flex-col gap-4">
            <div class="p-4 rounded-xl bg-surface-container border border-white/5 flex flex-col gap-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-tertiary flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[18px]">verified_user</span> Bóveda de Cifrado
                    </span>
                    <span class="text-[10px] font-mono bg-tertiary/10 text-tertiary px-2 py-0.5 rounded">AES-256</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    <div class="p-3 bg-surface-container-lowest rounded-lg border border-white/5 flex items-center justify-between">
                        <span class="font-bold text-xs">Acceso Biométrico (WebAuthn)</span>
                        <button onclick="requestBiometricAuth()" class="px-3 py-1 bg-primary/20 text-primary rounded text-xs font-bold">Verificar</button>
                    </div>
                    <div class="p-3 bg-surface-container-lowest rounded-lg border border-white/5 flex items-center justify-between">
                        <span class="font-bold text-xs">Purgar Datos Temporales</span>
                        <button onclick="purgeLocalData()" class="px-3 py-1 bg-secondary/20 text-secondary rounded text-xs font-bold">Purgar</button>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- PANEL DE AJUSTES -->
    <div id="settings-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden flex justify-end transition-all">
        <div class="w-full max-w-xs bg-surface-container-high h-full p-4 overflow-y-auto flex flex-col gap-5 border-l border-white/10">
            <div class="flex items-center justify-between border-b border-white/10 pb-3">
                <span class="font-bold text-sm">Personalización & Rendimiento</span>
                <button onclick="toggleSettingsModal()" class="w-7 h-7 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant">
                    <span class="material-symbols-outlined text-[16px]">close</span>
                </button>
            </div>
            <div class="flex flex-col gap-1.5">
                <label class="text-xs text-on-surface-variant font-semibold">Nombre de la App</label>
                <input type="text" id="input-app-name" value="OBSIDIAN NEXUS" class="bg-surface-container-lowest border border-white/10 rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:border-primary">
            </div>
            <div class="flex flex-col gap-1.5">
                <label class="text-xs text-on-surface-variant font-semibold">Tema de Color</label>
                <select id="select-app-theme" class="bg-surface-container-lowest border border-white/10 rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:border-primary">
                    <option value="theme-cyan">Ciberpunk Cyan</option>
                    <option value="theme-emerald">Obsidian Emerald</option>
                    <option value="theme-violet">Violet Core</option>
                    <option value="theme-mono">Monochrome OLED</option>
                </select>
            </div>
            <button onclick="applySettings()" class="w-full py-2.5 rounded-lg bg-primary text-black font-bold text-xs shadow-lg mt-auto">
                Aplicar Ajustes
            </button>
        </div>
    </div>

    <!-- SCRIPT DE OPTIMIZACIÓN Y CONTROL -->
    <script>
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById(tabId).classList.remove('hidden');

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('active', 'bg-primary', 'text-black');
                btn.classList.add('bg-surface-container-high', 'text-on-surface-variant');
            });

            const activeNav = document.getElementById('nav-' + tabId);
            activeNav.classList.remove('bg-surface-container-high', 'text-on-surface-variant');
            activeNav.classList.add('active', 'bg-primary', 'text-black');
        }

        function toggleSettingsModal() {
            document.getElementById('settings-modal').classList.toggle('hidden');
        }

        function applySettings() {
            const name = document.getElementById('input-app-name').value;
            const theme = document.getElementById('select-app-theme').value;

            document.getElementById('app-name-display').innerText = name;
            document.getElementById('app-title-head').innerText = name;

            const body = document.getElementById('app-body');
            body.classList.remove('theme-cyan', 'theme-emerald', 'theme-violet', 'theme-mono');
            body.classList.add(theme);

            toggleSettingsModal();
        }

        let currentLoadedFile = null;
        function loadLocalFile(event) {
            const file = event.target.files[0];
            if (!file) return;

            currentLoadedFile = file;
            document.getElementById('file-name-label').innerText = file.name;
            document.getElementById('file-size-label').innerText = `${(file.size / 1024).toFixed(1)} KB`;

            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('file-content-area').value = e.target.result;
                document.getElementById('file-editor-container').classList.remove('hidden');
            };
            reader.readAsText(file);
        }

        function saveModifiedFile() {
            const content = document.getElementById('file-content-area').value;
            const filename = currentLoadedFile ? `reparado_${currentLoadedFile.name}` : 'archivo_modificado.txt';
            const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            a.click();
            URL.revokeObjectURL(url);
        }

        function checkOsStatus() {
            document.getElementById('os-platform-text').innerText = navigator.platform || navigator.userAgent;
            document.getElementById('os-status-text').innerText = 'Recursos asignados al 100%';
        }

        function updateServiceWorker() {
            if ('serviceWorker' in navigator) {
                navigator.serviceWorker.getRegistrations().then(registrations => {
                    for (let registration of registrations) {
                        registration.update();
                    }
                    alert('Service Worker actualizado con éxito.');
                });
            }
        }

        function optimizeAppPerformance() {
            if (window.gc) {
                window.gc();
            }
            document.getElementById('cpu-ram-badge').innerText = 'CPU: Minimal | RAM: Clean';
            alert('Caché volatil purgada y recolección de basura solicitada.');
        }

        function sendChatMessage() {
            const input = document.getElementById('chat-input');
            const box = document.getElementById('chat-box');
            if (!input.value.trim()) return;

            const userMsg = document.createElement('div');
            userMsg.className = 'bg-primary/20 text-primary p-2 rounded-lg max-w-[85%] self-end text-on-surface';
            userMsg.innerText = input.value;
            box.appendChild(userMsg);

            setTimeout(() => {
                const aiMsg = document.createElement('div');
                aiMsg.className = 'bg-surface-container-high p-2 rounded-lg max-w-[85%] self-start text-on-surface';
                aiMsg.innerText = 'Instrucción procesada: ' + input.value;
                box.appendChild(aiMsg);
                box.scrollTop = box.scrollHeight;
            }, 400);

            input.value = '';
            box.scrollTop = box.scrollHeight;
        }

        function clearChat() {
            document.getElementById('chat-box').innerHTML = '<div class="bg-surface-container-high p-2.5 rounded-lg max-w-[85%] self-start text-on-surface">Memoria de chat liberada.</div>';
        }

        function initDeviceMonitoring() {
            if ('getBattery' in navigator) {
                navigator.getBattery().then(battery => {
                    document.getElementById('metric-battery').innerText = `${Math.round(battery.level * 100)}%`;
                });
            }
            if (navigator.hardwareConcurrency) {
                document.getElementById('metric-cores').innerText = `${navigator.hardwareConcurrency} Cores`;
            }
            document.getElementById('metric-network').innerText = navigator.onLine ? 'Online' : 'Offline';
            checkOsStatus();
        }

        function requestBiometricAuth() {
            alert('Verificación biométrica ejecutada.');
        }

        function purgeLocalData() {
            if (confirm('¿Purga de datos locales?')) {
                localStorage.clear();
                alert('Datos locales purgados.');
            }
        }

        window.addEventListener('DOMContentLoaded', initDeviceMonitoring);
    </script>
</body>
</html>
