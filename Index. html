<script>
  function triggerRecopy() {
    const btn = document.getElementById('btn-recopy');
    const label = document.getElementById('label-recopy');
    const originalText = label.innerText;

    // Simular copia en portapapeles y respuesta háptica visual
    navigator.clipboard?.writeText("<!DOCTYPE html>\n<!-- Aura AI Sovereign App Runtime v5.2.0 Monolithic Build -->\n" + document.querySelector('code')?.innerText || "");

    label.innerText = "¡Copiado de Nuevo al Portapapeles!";
    btn.classList.add('opacity-90', 'scale-95');
    setTimeout(() => {
      btn.classList.remove('scale-95');
      setTimeout(() => {
        label.innerText = originalText;
      }, 2000);
    }, 150);
  }

  function triggerDownloadFeedback(btn) {
    const origHtml = btn.innerHTML;
    btn.innerHTML = `<span class="material-symbols-outlined text-tertiary text-[18px]">done</span><span>¡Guardando .html!</span>`;
    setTimeout(() => {
      btn.innerHTML = origHtml;
    }, 2200);
  }

  function triggerLocalExec(btn) {
    const origHtml = btn.innerHTML;
    btn.innerHTML = `<span class="material-symbols-outlined text-primary text-[18px]">open_in_new</span><span>Invocando...</span>`;
    setTimeout(() => {
      btn.innerHTML = origHtml;
    }, 2000);
  }

  function copySnippet() {
    navigator.clipboard?.writeText(document.querySelector('code')?.innerText || "");
    alert("✓ Fragmento inicial copiado al portapapeles.");
  }

  function toggleCspModal() {
    const drawer = document.getElementById('csp-drawer');
    if (drawer.classList.contains('hidden')) {
      drawer.classList.remove('hidden');
      drawer.scrollIntoView({ behavior: 'smooth' });
    } else {
      drawer.classList.add('hidden');
    }
  }
